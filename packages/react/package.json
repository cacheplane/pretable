{
  "name": "@pretable/react",
  "version": "0.14.1",
  "description": "React components and hooks for Pretable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/pretable.git",
    "directory": "packages/react"
  },
  "homepage": "https://pretable.ai/docs/getting-started",
  "bugs": {
    "url": "https://github.com/cacheplane/pretable/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@pretable/core": "workspace:*",
    "@pretable/ui": "workspace:*"
  },
  "devDependencies": {
    "@pretable-internal/calendar-date": "workspace:*",
    "@pretable-internal/grid-core": "workspace:*",
    "@pretable-internal/row-model": "workspace:*",
    "@pretable-internal/renderer-dom": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "api": "api-extractor run --local --config api-extractor.json",
    "api:check": "api-extractor run --config api-extractor.json",
    "build": "tsdown --config tsdown.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:packaging": "publint --strict && attw --pack",
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  }
}
