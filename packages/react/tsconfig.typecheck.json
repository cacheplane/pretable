{
  // Typecheck-only project: resolves workspace deps through their built `.d.ts`
  // (the shape published consumers see) and, unlike `tsconfig.json`, includes
  // test files so fixtures cannot silently drift from the types they exercise.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@pretable/core": ["../core/dist/index.d.mts"],
      "@pretable/core/*": ["../core/dist/*.d.ts"],
      "@pretable-internal/grid-core": ["../grid-core/dist/index.d.ts"],
      "@pretable-internal/grid-core/*": ["../grid-core/dist/*.d.ts"],
      "@pretable-internal/row-model": ["../row-model/dist/index.d.ts"],
      "@pretable-internal/row-model/*": ["../row-model/dist/*.d.ts"],
      "@pretable-internal/renderer-dom": ["../renderer-dom/dist/index.d.ts"],
      "@pretable-internal/renderer-dom/*": ["../renderer-dom/dist/*.d.ts"]
    },
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": []
}
