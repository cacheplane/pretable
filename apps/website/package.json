{
  "name": "@pretable/app-website",
  "version": "0.0.32",
  "private": true,
  "description": "Pretable documentation and marketing site.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:deps": "pnpm --filter '@pretable/app-website^...' build",
    "predev": "pnpm run prepare:deps && pnpm run seo:sitemap && pnpm run examples:gen",
    "dev": "next dev",
    "examples:check": "node ./scripts/gen-example-registry.mjs --check",
    "examples:gen": "node ./scripts/gen-example-registry.mjs",
    "prebuild": "pnpm run prepare:deps && pnpm run seo:sitemap && pnpm run examples:gen",
    "seo:sitemap": "../../node_modules/.bin/tsx ./scripts/generate-sitemap.ts",
    "build": "next build",
    "prestart": "pnpm run prepare:deps",
    "start": "next start",
    "pretest": "pnpm run prepare:deps && pnpm run examples:gen",
    "test": "vitest run --environment jsdom",
    "smoke": "playwright test",
    "lint": "eslint app content --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pretable-internal/scenario-data": "workspace:*",
    "@pretable/core": "workspace:*",
    "@pretable/react": "workspace:*",
    "@pretable/stream-adapter": "workspace:*",
    "@pretable/ui": "workspace:*",
    "fuzzysort": "^3.1.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.3.3",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@next/mdx": "^16.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
