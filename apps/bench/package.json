{
  "name": "@pretable/app-bench",
  "private": true,
  "version": "0.0.32",
  "description": "Pretable benchmark lab and browser test target.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:deps": "pnpm --filter '@pretable/app-bench^...' build",
    "predev": "pnpm run prepare:deps",
    "dev": "vite",
    "prebuild": "pnpm run prepare:deps",
    "build": "vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "prepreview": "pnpm run build",
    "preview": "vite preview",
    "prepreview:bench": "pnpm run build",
    "preview:bench": "vite preview --host 127.0.0.1 --port 4173",
    "pretest": "pnpm run prepare:deps",
    "test": "vitest run --environment jsdom --passWithNoTests",
    "pretypecheck": "pnpm run prepare:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mui/material": "^9.3.1",
    "@mui/x-data-grid": "^9.12.0",
    "@pretable-internal/bench-runner": "workspace:*",
    "@pretable-internal/scenario-data": "workspace:*",
    "@pretable-internal/row-model": "workspace:*",
    "@pretable/react": "workspace:*",
    "@pretable/stream-adapter": "workspace:*",
    "@pretable/ui": "workspace:*",
    "@tanstack/react-table": "^9.2.3",
    "@tanstack/react-virtual": "^3.14.10",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
