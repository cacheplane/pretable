{
  "compilerOptions": {
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react",
    "lib": ["DOM", "ES2018"],
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "noEmit": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2018"
  },
  "include": ["public-api.tsx"]
}
